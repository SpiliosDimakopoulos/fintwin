{
  "name": "FinTwin",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/node:1": { "version": "22" },
    "ghcr.io/va-h/devcontainers-features/uv:1": {}
  },
  "postCreateCommand": "cp -n .env.example .env; cd engine && uv sync && cd ../web && npm ci",
  "forwardPorts": [5173],
  "customizations": {
    "vscode": { "extensions": ["ms-python.python", "charliermarsh.ruff", "dbaeumer.vscode-eslint"] }
  }
}
